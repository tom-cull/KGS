Elasticity (Log-Log Slope) = 
VAR DataSet1 =
    ADDCOLUMNS (
        SUMMARIZE (
            'Price Elasticity',
            'Price Elasticity'[ASP (.05)],
            'Price Elasticity'[3rd Item Number],
            'Price Elasticity'[Channel Description]
        ),
        "Q",
            CALCULATE ( divide( SUM ( 'Price Elasticity'[Qty] ) , DISTINCTCOUNT('Price Elasticity'[Year-Week]))),
        "P",
            CALCULATE (
                DIVIDE (
                    SUMX ( 'Price Elasticity', 'Price Elasticity'[ASP] * 'Price Elasticity'[Qty] ),
                    SUM ( 'Price Elasticity'[Qty] )
                )
            ),
        "LnQ",
            VAR q = CALCULATE ( divide( SUM ( 'Price Elasticity'[Qty] ) , DISTINCTCOUNT('Price Elasticity'[Year-Week])))
            RETURN IF ( q > 0, LN ( q ), BLANK () ),
        "LnP",
            VAR p = CALCULATE (
                    DIVIDE (
                        SUMX ( 'Price Elasticity', 'Price Elasticity'[ASP] * 'Price Elasticity'[Qty] ),
                        SUM ( 'Price Elasticity'[Qty] )
                    )
                )
            RETURN IF ( p > 0, LN ( p * 100 ), BLANK () )
    )



VAR P_Low = PERCENTILEX.INC(DataSet1, [P], 0.05)
VAR P_High = PERCENTILEX.INC(DataSet1, [P], 0.95)
VAR DataSet2 =
    FILTER(
        DataSet1,
        [P] >= P_Low &&
        [P] <= P_High &&
        [Q] > 0
    )
VAR RegTable =
    LINESTX ( DataSet1, [LnQ], [LnP] )
RETURN
MAXX ( RegTable, [Slope1] )
